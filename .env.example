# pm (frontend) — variables read by docker-compose.yml on the server.
# In production /opt/pm/.env is WRITTEN BY GITHUB ACTIONS on every deploy (deploy.yml). Do not edit by hand.

IMAGE_TAG=sha-1a2b3c4                    # image tag being deployed
WEB_IMAGE=ghcr.io/ambag12/pm-web
EDGE_NETWORK=socketsoft-site_default     # detected from the socketsoft Caddy container

# Build-time only (baked into the bundle; not a secret). Used by `npm run dev`/`build` and local docker builds.
VITE_API_URL=https://pm-api.socketsoft.io/api/v1/
